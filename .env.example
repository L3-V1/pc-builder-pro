# Coleta de preços do `npm run pipeline` (copie para .env.local, que não vai para o Git).
# Crie o app em https://developers.mercadolivre.com.br com a redirect URI https://localhost.
ML_CLIENT_ID=
ML_CLIENT_SECRET=
# Gravado por `npx tsx pipeline/ferramentas/autorizar-ml.ts` e regravado a cada execução,
# porque o Mercado Livre troca o refresh token a cada uso. Vazio: tenta client_credentials.
ML_REFRESH_TOKEN=
